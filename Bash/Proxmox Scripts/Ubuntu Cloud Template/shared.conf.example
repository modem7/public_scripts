# =============================================================================
#  shared.conf  -  settings for every template built by build-templates.sh
#  ./build-templates.sh --init copies this to ~/.config/ubuntu-templates/
#  shared.conf (outside the git clone). Or copy it to shared.conf next to
#  the script: *.conf is git-ignored. It holds passwords and keys. Anything
#  left out keeps the script default.
#
#  Per-template VM settings (name, tags, packages, snapd, IPv6, desktop,
#  RAM, disk) are not here: they live in profiles/<template>.conf.
#  Copy profiles/<template>.conf.example for each template you build.
#
#  Moving from build-templates.conf: rename it to shared.conf. PKGS_* and
#  TAG_BASE are no longer read (set EXTRA_VIRT_PKGS and TAG in the
#  profiles instead).
# =============================================================================

# --- Paths ---
# PUBLIC_SCRIPT="/root/create-ubuntu-cloud-template.sh"   # downloaded if missing
# OUT_DIR="$SCRIPT_DIR/template-build"                    # generated files (root-only); default

# --- Host defaults ---
# Written into every profile first, so a profile can override any of them.
# In a profile, override the SSH key with SSH_KEY and the login with
# CLOUD_USER_DEFAULT, not CI_SSH_KEY / CI_USER.
DISTRO_VER="resolute"
DISK_STOR=""           # blank = the host's only VM-disk storage (local-lvm or
                       # local-zfs). Set it only if the host has several.
NET_BRIDGE="vmbr0"
VLAN=""                # blank = no VLAN tag
CI_USER="ubuntu"                             # cloud-init login name
CI_SSH_KEY="github.com/<your-github-user>"   # cloud-init user's key(s), or the key itself
CLOUD_PASSWORD=""                            # blank = generated each build

# --- Ansible user (required) ---
ANSIBLE_SSH_PUBKEY="ssh-ed25519 AAAA... ansible"

# --- Postfix mail relay ---
# MAIL_RELAY: gmail  = smtp.gmail.com port 587 (MAIL_RELAY_HOST/PORT ignored)
#             custom = MAIL_RELAY_HOST and MAIL_RELAY_PORT below
#             none   = no relay: mail stays on the clone
MAIL_RELAY="gmail"
MAIL_RELAY_HOST=""                           # custom only: host name or IPv4 address
MAIL_RELAY_PORT=""                           # custom only: 587 (STARTTLS, required),
                                             # 465 (TLS from the start), 25 (TLS required with a login,
                                             # else if offered)
MAIL_RELAY_USER="you@gmail.com"              # SMTP login; custom: blank = no login
MAIL_RELAY_PASSWORD="xxxxxxxxxxxxxxxx"       # Gmail: a Google app password
MAIL_ROOT_TO=""                              # root's mail; blank = MAIL_RELAY_USER if it is an address
MAIL_SENDER=""                               # blank = no rewrite; set = every sender becomes this
MAIL_DOMAIN="example.com"                    # mail is sent as user@<short hostname>.example.com
# The old names GMAIL_USER and GMAIL_APP_PASSWORD still work (with a warning).

# --- Unattended upgrades report (blank = no mail) ---
UU_MAIL="you@gmail.com"

# --- System tweaks ---
LOGIN_SHELL="/usr/bin/zsh"        # clone's login user + new users; blank = leave bash.
#   /usr/bin, not /bin: your dotfiles compare $SHELL with `which zsh`.
NEEDRESTART_MODE="a"          # a = restart services itself, l = list, i = ask; blank = OS default (i)
HIDE_PRO_ADVERTS="yes"        # no Ubuntu Pro/ESM adverts in apt or the login message
# Journal cap, re-worked out every boot: min(JOURNAL_MAX_MB, JOURNAL_MAX_PERCENT % of disk).
# Blank JOURNAL_MAX_MB = OS default (10% of disk, capped at 4G).
JOURNAL_MAX_MB="1024"
JOURNAL_MAX_PERCENT="10"

# --- /etc/skel ---
DOTFILES_RAW="https://raw.githubusercontent.com/<you>/dotfiles/master"   # blank = none
# DOTFILES=(.p10k.zsh .zshrc .zshenv)
# Whole ~/.wakatime.cfg for new users (blank = none):
WAKATIME_CFG='[settings]
api_key = xxxxxxxx'
