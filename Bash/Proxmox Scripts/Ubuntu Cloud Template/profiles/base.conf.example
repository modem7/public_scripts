# =============================================================================
#  profiles/base.conf  -  the base template: a server
#  ./build-templates.sh --init copies this to profiles/base.conf in your config
#  folder (next to shared.conf). Or copy it to profiles/base.conf next to the
#  script: *.conf is git-ignored.
#
#  A plain create-ubuntu-cloud-template.sh profile (see profile.conf.example
#  for every key). build-templates.sh puts the host defaults from shared.conf
#  (DISTRO_VER, DISK_STOR, NET_BRIDGE, VLAN, CLOUD_USER_DEFAULT, SSH_KEY, CLOUD_PASSWORD) before
#  it, so anything set here wins. It then appends the payloads, plus any of
#  libsasl2-modules, unattended-upgrades and zsh missing from EXTRA_VIRT_PKGS.
#  No secrets here: they belong in shared.conf.
# =============================================================================

TEMPL_NAME_DEFAULT="ubuntu-2604-base"
TAG="template;ubuntu;base"
# extras without the admin tools.
EXTRA_VIRT_PKGS="aptitude,auto-apt-proxy,libsasl2-modules,tuned,tuned-utils,unattended-upgrades,zsh"
CONVERT_TO_TEMPLATE="yes"

# The stock root has ~1-2 GB free: grow first so the installs always fit.
GROW_IMAGE_FIRST="yes"
REMOVE_SNAPD="yes"
TUNED_PROFILE="virtual-guest"
DISABLE_IPV6="yes"
ENABLE_FSTRIM_TIMER="yes"
UNATTENDED_UPGRADES="yes"
UU_AUTOCLEAN_DAYS="7"
# No UU_AUTO_REBOOT: never reboot by itself (OS default). needrestart and
# the login message say when a reboot is needed.
