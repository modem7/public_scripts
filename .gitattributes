# Line endings: normalise text to LF in the repo and on checkout.
* text=auto eol=lf

# Windows scripts need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Text types with a diff driver where git has one.
*.py text diff=python
*.md text diff=markdown
*.sh text eol=lf diff=bash
*.bats text eol=lf diff=bash
*.yml text
*.yaml text
*.json text
*.toml text

# Binary files: never convert or diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.exe binary
*.xlsx binary
